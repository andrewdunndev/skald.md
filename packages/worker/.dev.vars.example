# Cloudflare Worker secrets required for skald.
#
# After deploying (via the Deploy-to-Cloudflare button or
# `wrangler deploy`), run these once. The Deploy button cannot prompt
# for secret values; this file documents what you'll need to set.
#
#   pnpm exec wrangler secret put SKALD_TOKENS
#   pnpm exec wrangler secret put ANTHROPIC_API_KEY        # optional fallback
#   pnpm exec wrangler secret put AI_GATEWAY_URL           # optional caching

# Per-client tokens with scopes. JSON array. Generate each token with:
#   openssl rand -hex 32
# Then paste the value as the secret. See docs/deploying-the-worker.md
# for the full setup walkthrough.
SKALD_TOKENS=[
  { "label": "plugin",      "token": "<hex>", "scopes": ["chat", "mcp:read"] },
  { "label": "claude-code", "token": "<hex>", "scopes": ["mcp:read"] }
]

# Optional fallback Anthropic API key. The plugin can supply its own via
# settings, but if it doesn't, the Worker uses this. Leave unset to
# require plugin-supplied keys only.
ANTHROPIC_API_KEY=sk-ant-...

# Optional Cloudflare AI Gateway URL. When set, the Worker routes
# Anthropic calls through Gateway for caching + observability. Find your
# account_id at dash.cloudflare.com → Workers & Pages. Gateway
# auto-creates on first request as of 2026-03.
AI_GATEWAY_URL=https://gateway.ai.cloudflare.com/v1/<account_id>/skald/anthropic/v1/messages
