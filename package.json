{
  "name": "skald",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vault-native Claude client for Obsidian. Mobile-first, bring your own API key, no server required.",
  "license": "MIT",
  "author": "Andrew Dunn <andrew@dunn.dev>",
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "claude",
    "anthropic",
    "ai",
    "llm",
    "mobile",
    "knowledge-management"
  ],
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/dunn.dev/skald.md.git"
  },
  "scripts": {
    "dev:plugin": "pnpm --filter @skald/plugin dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "audit:prod": "pnpm audit --prod",
    "lint": "eslint packages/plugin/src --max-warnings 0",
    "check:cors": "node scripts/check-cors.mjs",
    "smoke:live": "node scripts/smoke-live.mjs",
    "test:e2e": "pnpm --filter @skald/plugin build && pnpm --filter @skald/e2e test",
    "check": "pnpm typecheck && pnpm test && pnpm lint && pnpm --filter @skald/plugin build"
  },
  "packageManager": "pnpm@12.18.0",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@eslint/json": "2.1.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-plugin-obsidianmd": "0.4.2",
    "typescript": "6.0.3",
    "typescript7": "npm:typescript@7.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "5.1.0"
  }
}
