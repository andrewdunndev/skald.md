{
  "name": "skald",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vault-native Claude client for Obsidian. Mobile-first, bring your own API key, no server required.",
  "license": "MIT",
  "author": "Andrew Dunn <andrew@dunn.dev>",
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "claude",
    "anthropic",
    "ai",
    "llm",
    "mobile",
    "knowledge-management"
  ],
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/dunn.dev/skald.md.git"
  },
  "scripts": {
    "dev:plugin": "pnpm --filter @skald/plugin dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "audit:prod": "pnpm audit --prod",
    "check:size": "node scripts/check-size.mjs",
    "check:lint": "node scripts/check-plugin-lint.mjs",
    "check:cdp": "node scripts/cdp-walkthrough.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm check:size && pnpm check:lint && pnpm --filter @skald/plugin build"
  },
  "packageManager": "pnpm@11.21.0",
  "devDependencies": {
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@vitest/coverage-v8": "4.1.10",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
