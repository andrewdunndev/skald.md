{
  "name": "scribian",
  "version": "0.0.6",
  "private": true,
  "type": "module",
  "description": "Vault-native Claude client for Obsidian.",
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/dunn.dev/scribian.git"
  },
  "scripts": {
    "dev:plugin": "pnpm --filter @scribian/plugin dev",
    "dev:worker": "pnpm --filter @scribian/worker dev",
    "build": "pnpm -r build",
    "deploy:worker": "pnpm --filter @scribian/worker deploy",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:size": "node scripts/check-size.mjs",
    "check:lint": "node scripts/check-plugin-lint.mjs",
    "check:cdp": "node scripts/cdp-walkthrough.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm check:size && pnpm check:lint && pnpm --filter @scribian/plugin build"
  },
  "packageManager": "pnpm@11.1.1",
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9"
  }
}
