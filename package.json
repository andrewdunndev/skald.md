{
  "name": "skald",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vault-native Claude client for Obsidian. Mobile-first, bring your own API key, no server required.",
  "license": "MIT",
  "author": "Andrew Dunn <andrew@dunn.dev>",
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "claude",
    "anthropic",
    "ai",
    "llm",
    "mobile",
    "knowledge-management"
  ],
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/dunn.dev/skald.md.git"
  },
  "scripts": {
    "dev:plugin": "pnpm --filter @skald/plugin dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "audit:prod": "pnpm audit --prod",
    "check:lint": "node scripts/check-plugin-lint.mjs",
    "check:cors": "node scripts/check-cors.mjs",
    "smoke:live": "node scripts/smoke-live.mjs",
    "test:e2e": "pnpm --filter @skald/plugin build && pnpm --filter @skald/e2e test",
    "check": "pnpm typecheck && pnpm test && pnpm check:lint && pnpm --filter @skald/plugin build"
  },
  "packageManager": "pnpm@12.8.1",
  "devDependencies": {
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@vitest/coverage-v8": "5.0.2",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
